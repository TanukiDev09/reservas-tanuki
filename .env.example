# Copia este archivo a .env y ajusta los valores.

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/avisos-tanuki

# URL pública final de la página (la usa el QR: npm run qr)
SITE_URL=https://avisos.tanukilibros.com

# Acceso a /admin (obligatorios; usa una contraseña larga)
ADMIN_USER=tanuki
ADMIN_PASSWORD=cambia-esta-contrasena

# Documentos legales que enlazan las casillas del formulario
TERMS_URL=https://tanukilibros.com/terminos-de-uso/
PRIVACY_URL=https://tanukilibros.com/privacy-policy/

# Versión del texto de autorización. Súbela cuando cambies el texto
# (se guarda con cada inscripción junto con la fecha).
AUTH_TEXT_VERSION=2026-10-v1

# Antispam: máximo de envíos por IP en la ventana (minutos)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MIN=60

# Pon 1 si el hosting usa proxy inverso (casi siempre), para leer la IP real
TRUST_PROXY=1
